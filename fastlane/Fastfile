default_platform(:android)

def version_name
  ENV["APP_VERSION_NAME"] or UI.user_error!("APP_VERSION_NAME env is not set")
end

def version_code
  ENV["APP_VERSION_CODE"] or UI.user_error!("APP_VERSION_CODE env is not set")
end

def ios_marketing_version
  config_path = File.expand_path("../iosApp/Configuration/Config.xcconfig", __dir__)
  config = File.read(config_path)
  match = config.match(/^\s*MARKETING_VERSION\s*=\s*([^\s]+)\s*$/)
  match ? match[1] : UI.user_error!("MARKETING_VERSION is missing from Config.xcconfig")
end

def validate_ios_release_notes
  metadata_root = File.expand_path("metadata/ios", __dir__)
  missing = Dir[File.join(metadata_root, "*")].select { |locale_root|
    !File.file?(File.join(locale_root, "release_notes.txt")) ||
      File.read(File.join(locale_root, "release_notes.txt"), encoding: "UTF-8").strip.empty?
  }.map { |locale_root| File.basename(locale_root) }
  UI.user_error!("Missing iOS release notes for: #{missing.join(', ')}") unless missing.empty?
end

# ---------------------------------------------------------------------------
# Android — Google Play internal track
# ---------------------------------------------------------------------------
platform :android do
  desc "Upload localized Google Play listing changes without sending for review"
  lane :publish_store_listing_draft do
    play_store_json_key = ENV["PLAY_STORE_JSON_KEY"]
    if play_store_json_key.to_s.empty?
      UI.user_error!("PLAY_STORE_JSON_KEY env is not set")
    end

    upload_to_play_store(
      package_name: "ge.yet.blokblast",
      metadata_path: "fastlane/metadata/android",
      json_key_data: play_store_json_key,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      sync_image_upload: true,
      changes_not_sent_for_review: true,
      rescue_changes_not_sent_for_review: true,
    )
  end

  desc "Build signed AAB+APK and upload AAB to Google Play (internal track)"
  lane :release do
    # AAB for Play (Play only accepts bundles for new uploads).
    gradle(
      task: "androidApp:bundleRelease",
      properties: {
        "appVersionName" => version_name,
        "appVersionCode" => version_code,
      },
    )

    # APK for the GitHub Release attachment (sideload/internal testing).
    gradle(
      task: "androidApp:assembleRelease",
      properties: {
        "appVersionName" => version_name,
        "appVersionCode" => version_code,
      },
    )

    upload_to_play_store(
      package_name: "ge.yet.blokblast",
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end

# ---------------------------------------------------------------------------
# iOS — App Store Connect listing and build upload
# ---------------------------------------------------------------------------
platform :ios do
  desc "Upload localized App Store listing changes without sending for review"
  lane :publish_app_store_listing_draft do
    %w[
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_KEY_CONTENT
    ].each do |variable|
      UI.user_error!("#{variable} env is not set") if ENV[variable].to_s.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    validate_ios_release_notes

    upload_to_app_store(
      api_key: api_key,
      app_identifier: "ge.yet3.blokblast.BlockBlast",
      app_version: ios_marketing_version,
      metadata_path: "fastlane/metadata/ios",
      screenshots_path: "fastlane/screenshots",
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
    )
  end

  desc "Build a signed IPA and upload it to App Store Connect/TestFlight"
  lane :release do
    %w[
      APP_VERSION_NAME
      APP_VERSION_CODE
      APP_STORE_CONNECT_KEY_ID
      APP_STORE_CONNECT_ISSUER_ID
      APP_STORE_CONNECT_KEY_CONTENT
      IOS_PROVISIONING_PROFILE_NAME
    ].each do |variable|
      UI.user_error!("#{variable} env is not set") if ENV[variable].to_s.empty?
    end

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
    )
    profile_name = ENV["IOS_PROVISIONING_PROFILE_NAME"]

    # Sign only the application target. Swift Package targets do not support
    # provisioning profiles and must keep their default package settings.
    update_code_signing_settings(
      path: "iosApp/iosApp.xcodeproj",
      targets: ["iosApp"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: "3KKQ642Q9H",
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "ge.yet3.blokblast.BlockBlast",
      profile_name: profile_name,
    )

    build_app(
      project: "iosApp/iosApp.xcodeproj",
      scheme: "iosApp",
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      output_directory: "build/ios",
      output_name: "Logica.ipa",
      archive_path: "build/ios/Logica.xcarchive",
      derived_data_path: "build/ios/DerivedData",
      include_symbols: true,
      xcargs: [
        "MARKETING_VERSION=#{ENV['APP_VERSION_NAME']}",
        "CURRENT_PROJECT_VERSION=#{ENV['APP_VERSION_CODE']}",
        "DEVELOPMENT_TEAM=3KKQ642Q9H",
        "PRODUCT_BUNDLE_IDENTIFIER=ge.yet3.blokblast.BlockBlast",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
      ].join(" "),
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: "3KKQ642Q9H",
        provisioningProfiles: {
          "ge.yet3.blokblast.BlockBlast" => profile_name,
        },
        uploadSymbols: true,
      },
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "ge.yet3.blokblast.BlockBlast",
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH],
      skip_waiting_for_build_processing: true,
      distribute_external: false,
    )
  end
end
