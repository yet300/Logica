default_platform(:android)

def version_name
  ENV["APP_VERSION_NAME"] or UI.user_error!("APP_VERSION_NAME env is not set")
end

def version_code
  ENV["APP_VERSION_CODE"] or UI.user_error!("APP_VERSION_CODE env is not set")
end

# ---------------------------------------------------------------------------
# Android — Google Play internal track
# ---------------------------------------------------------------------------
platform :android do
  desc "Stage one generated screenshot locale without uploading it"
  lane :stage_store_assets do
    locale = ENV["SCREENSHOT_LOCALE"] or UI.user_error!("SCREENSHOT_LOCALE env is not set")
    export_root = ENV.fetch("SCREENSHOT_EXPORT_ROOT", "store-assets/ci-exports")
    sh(
      "python3",
      "tools/store_screenshots/stage_fastlane.py",
      "--input", export_root,
      "--fastlane-root", "fastlane",
      "--locale", locale,
    )
  end

  desc "Upload localized Google Play listing changes without sending for review"
  lane :publish_store_listing_draft do
    play_store_json_key = ENV["PLAY_STORE_JSON_KEY"]
    if play_store_json_key.to_s.empty?
      UI.user_error!("PLAY_STORE_JSON_KEY env is not set")
    end

    upload_to_play_store(
      package_name: "ge.yet.blokblast",
      metadata_path: "fastlane/metadata/android",
      json_key_data: play_store_json_key,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: true,
      skip_upload_images: false,
      skip_upload_screenshots: false,
      sync_image_upload: true,
      changes_not_sent_for_review: true,
      rescue_changes_not_sent_for_review: false,
    )
  end

  desc "Build signed AAB+APK and upload AAB to Google Play (internal track)"
  lane :release do
    # AAB for Play (Play only accepts bundles for new uploads).
    gradle(
      task: "androidApp:bundleRelease",
      properties: {
        "appVersionName" => version_name,
        "appVersionCode" => version_code,
      },
    )

    # APK for the GitHub Release attachment (sideload/internal testing).
    gradle(
      task: "androidApp:assembleRelease",
      properties: {
        "appVersionName" => version_name,
        "appVersionCode" => version_code,
      },
    )

    upload_to_play_store(
      package_name: "ge.yet.blokblast",
      track: "internal",
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      json_key_data: ENV["PLAY_STORE_JSON_KEY"],
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
